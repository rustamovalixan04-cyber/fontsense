    {
      "id": "learning",
      "label": "Best CNN training history",
      "path": "reports/cnn/cnn_training_history.csv",
      "query": {
        "engine": "sqlite",
        "language": "sql",
        "sql": "SELECT epoch, 'Train loss' AS series, train_loss AS value,\n               train_accuracy, validation_accuracy, validation_macro_f1\n        FROM cnn_training_history\n        WHERE run = 'Reference small CNN'\n        UNION ALL\n        SELECT epoch, 'Validation loss', validation_loss,\n               train_accuracy, validation_accuracy, validation_macro_f1\n        FROM cnn_training_history\n        WHERE run = 'Reference small CNN'\n        ORDER BY epoch, series",
        "description": "Reads train and validation loss from the selected CNN run by epoch.",
        "executed_at": "2026-07-27T12:42:34Z",
        "tables_used": [
          "cnn_training_history"
        ]
      }
