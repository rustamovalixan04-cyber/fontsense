      "path": "reports/cnn/cnn_experiment_comparison.csv",
      "query": {
        "engine": "sqlite",
        "language": "sql",
        "sql": "SELECT run_order, run_name, reason, learning_rate, width, dropout,\n               image_width, image_height, batch_size, epochs_trained,\n               best_epoch, stopped_early, validation_macro_f1,\n               validation_accuracy, training_seconds,\n               inference_ms_per_image, model_size_bytes, parameter_count\n        FROM cnn_experiments\n        ORDER BY run_order",
        "description": "Reads controlled settings, results, runtime, and size for each CNN run.",
        "executed_at": "2026-07-27T12:42:34Z",
        "tables_used": [
          "cnn_experiments"
        ]
      }
