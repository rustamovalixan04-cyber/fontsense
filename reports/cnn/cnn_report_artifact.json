      "id": "model_comparison",
      "label": "Majority, HOG, and CNN validation comparison",
      "path": "reports/cnn/model_comparison.csv",
      "query": {
        "engine": "sqlite",
        "language": "sql",
        "sql": "SELECT model, model_family, validation_macro_f1,\n               validation_accuracy, inference_ms_per_image,\n               model_size_bytes, selection_basis\n        FROM model_comparison\n        ORDER BY validation_macro_f1 DESC",
        "description": "Compares the selected validation result from each required model family.",
        "executed_at": "2026-07-27T12:42:34Z",
        "tables_used": [
          "model_comparison"
        ]
      }
    },
    {
      "id": "per_class",
      "label": "Best CNN per-class validation metrics",
      "path": "reports/cnn/best_cnn_classification_report.csv",
      "query": {
        "engine": "sqlite",
        "language": "sql",
        "sql": "SELECT class, precision, recall, f1, support\n        FROM best_cnn_per_class\n        ORDER BY f1 DESC, class",
        "description": "Reads precision, recall, F1, and support for all five categories.",
