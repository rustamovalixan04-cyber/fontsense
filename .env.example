# Server-only. Set these in the hosting environment; never in browser code.
# Python does not automatically load this example or a .env file.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6.1-sol
# Generate a separate random private code with at least 32 characters.
FONTSENSE_ANALYSIS_ACCESS_CODE=
# A dedicated Upstash Redis REST database provides shared usage counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
FONTSENSE_ANALYSIS_DAILY_LIMIT=25
